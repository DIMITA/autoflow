{
  "mode": "sprint",
  "risk_threshold": "medium",
  "trusted_paths": ["src/", "tests/", "collectors/", "etl/"],
  "trusted_commands": [
    "pytest",
    "git add",
    "git commit",
    "git status",
    "git diff",
    "git log",
    "docker-compose up",
    "pip install",
    "python",
    "python3",
    "ls",
    "cat",
    "grep",
    "find",
    "echo",
    "pwd",
    "which",
    "mkdir",
    "cp",
    "mv"
  ],
  "blocked_patterns": [
    "rm -rf",
    "--force",
    "-f ",
    "DROP TABLE",
    "DROP DATABASE",
    "TRUNCATE",
    "shutdown",
    "reboot",
    "format",
    "mkfs"
  ],
  "notify_on": ["git commit", "docker-compose restart", "docker-compose down"],
  "sensitive_files": [
    ".env",
    ".env.prod",
    ".env.production",
    ".env.local",
    "docker-compose.prod.yml",
    "docker-compose.production.yml",
    "secrets.json",
    "credentials.json"
  ],
  "profiles": {
    "sprint-etl": {
      "trusted_paths": ["src/collectors/", "src/etl/", "tests/"],
      "risk_threshold": "low"
    },
    "sprint-full": {
      "trusted_paths": ["src/", "tests/", "collectors/", "etl/", "scripts/"],
      "risk_threshold": "medium"
    },
    "review": {
      "risk_threshold": "high",
      "notify_on": ["*"]
    },
    "safe": {
      "trusted_paths": [],
      "risk_threshold": "high",
      "blocked_patterns": ["rm", "drop", "delete", "force", "--hard"]
    }
  },
  "checkpoint_before": [
    "docker-compose down",
    "alembic upgrade",
    "alembic downgrade",
    "alembic stamp",
    "git reset",
    "git rebase"
  ]
}
