{
  "mode": "sprint",
  "risk_threshold": "medium",
  "trusted_paths": ["src/", "tests/", "test/", "lib/", "app/"],
  "trusted_commands": [
    "pytest", "python", "python3",
    "npm test", "npm run", "npx", "node",
    "yarn", "pnpm",
    "git add", "git commit", "git status", "git diff", "git log", "git show",
    "make", "cargo", "go test", "go build",
    "ls", "cat", "grep", "find", "echo", "pwd", "which",
    "mkdir", "cp", "mv", "touch",
    "pip install", "pip freeze",
    "docker-compose up", "docker-compose logs",
    "curl", "jq"
  ],
  "blocked_patterns": [
    "rm -rf",
    "--force",
    "DROP TABLE",
    "DROP DATABASE",
    "TRUNCATE TABLE",
    "shutdown",
    "reboot",
    "mkfs"
  ],
  "sensitive_files": [
    ".env",
    ".env.prod",
    ".env.production",
    ".env.local",
    ".env.staging",
    "docker-compose.prod.yml",
    "docker-compose.production.yml",
    "secrets.json",
    "credentials.json",
    "service-account.json",
    "*.pem",
    "*.key"
  ],
  "notify_on": ["git commit", "git push"],
  "checkpoint_before": [],
  "profiles": {
    "sprint": {
      "trusted_paths": ["src/", "tests/", "test/"],
      "risk_threshold": "medium"
    },
    "strict": {
      "trusted_paths": [],
      "risk_threshold": "low"
    },
    "review": {
      "risk_threshold": "high",
      "notify_on": ["*"]
    }
  },
  "_project_override": "Copy this file to your project root and customise. Project-level autoflow.config.json takes precedence over this default."
}
