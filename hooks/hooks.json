{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AUTOFLOW_ROOT}/scripts/decision-engine.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AUTOFLOW_ROOT}/scripts/post-tool-logger.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AUTOFLOW_ROOT}/scripts/session-stop.py\""
          }
        ]
      }
    ]
  }
}
